{
  "name": "pharmatalent-backend",
  "version": "1.1.0",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "respaldo": "node scripts/respaldo.js",
    "respaldos": "node scripts/respaldo.js --listar",
    "restaurar": "node scripts/restaurar.js",
    "integridad": "node scripts/integridad.js",
    "auditoria": "node scripts/auditoria-roles.js",
    "privacidad": "node scripts/verificar-privacidad.js",
    "crear-admin": "node scripts/crear-administrador.js",
    "exposicion": "node scripts/preparar-exposicion.js",
    "tunel": "node scripts/tunel.js",
    "test:integracion": "node --test --test-concurrency=1 tests/integracion/*.test.js",
    "test:funcional": "node scripts/pruebas-funcionales.js",
    "pruebas": "node scripts/informe-pruebas.js",
    "preventivo": "node scripts/mantenimiento-preventivo.js",
    "carga": "node scripts/prueba-carga.js",
    "historial-mantenimiento": "node scripts/registrar-mantenimiento.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ]
  },
  "author": "Marc Aquino Carhuas <marcaquinocarhuas@gmail.com>",
  "license": "UNLICENSED",
  "description": "Sistema de gestión de personal para cadenas de boticas. Software propietario: ver LICENSE.",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "private": true
}
