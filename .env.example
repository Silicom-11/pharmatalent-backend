# ─── PharmaTalent · configuración del servidor ───────────────────────────────
# Copie este archivo como .env y complete los valores.
# El servidor comprueba lo esencial al arrancar y se niega a subir si falta algo.

PORT=5000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://localhost:27017/pharmatalent

# Clave con la que se firman las sesiones. NO reutilice la de otro entorno.
# Genere una así:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (formato de la librería jsonwebtoken: 8h, 7d, 30m...)
JWT_EXPIRES_IN=8h

# Orígenes autorizados a llamar a la API, separados por coma.
# Obligatorio en producción: sin esto cualquier sitio podría consultar la API
# desde el navegador de un usuario con sesión abierta.
CORS_ORIGINS=http://localhost:3000

# Zona horaria de la operación. Se llama ZONA_HORARIA y no TZ a propósito:
# los servidores en la nube definen TZ=UTC en el entorno y esa variable ganaría
# a este archivo. Allí, una marca de asistencia de las 22:00 quedaría
# registrada al día siguiente.
ZONA_HORARIA=America/Lima

# development | production
NODE_ENV=development

# Modo exposición (ver src/config/exposicion.js): MODO_EXPOSICION=completo (todos los roles con un clic) o junin (recorrido corto) muestra
# sólo Junín y cuatro roles con cambio de rol sin contraseña. Nunca en producción.
MODO_EXPOSICION=

# PIN del acceso por rol cuando se entra por el túnel (npm run tunel)
EXPOSICION_PIN=

# Contraseña común de las cuentas de demostración que crean seed.js y
# coherencia.js --demo. No va en el código porque el repositorio es público.
CLAVE_DEMO=
